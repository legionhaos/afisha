# Copy to .env locally. Never commit or send through public chats.
# OpenRouter chat model
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-your-openrouter-key
LLM_MODEL_NAME=google/gemma-4-31b-it:free
# Optional: a separate OpenRouter key for embeddings. Empty uses LLM_API_KEY.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=nvidia/nemotron-3.5-embed-8b:free
EMBEDDING_DIMENSIONS=1536
# Set a long random value; never expose the backend directly to the internet.
ADMIN_API_TOKEN=replace-with-a-long-random-secret
